{
  local d = (import 'doc-util/main.libsonnet'),
  '#':: d.pkg(name='compositePodGroupTemplate', url='', help='"CompositePodGroupTemplate represents a template for a CompositePodGroup with a scheduling policy."'),
  '#disruptionMode':: d.obj(help='"CompositeDisruptionMode defines how individual entities within a composite pod group can be disrupted. Exactly one mode must be set."'),
  disruptionMode: {
    '#withAll':: d.fn(help='"AllCompositeDisruptionMode means that children of a CompositePodGroup can only be disrupted or preempted together."', args=[d.arg(name='all', type=d.T.object)]),
    withAll(all): { disruptionMode+: { all: all } },
    '#withAllMixin':: d.fn(help='"AllCompositeDisruptionMode means that children of a CompositePodGroup can only be disrupted or preempted together."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='all', type=d.T.object)]),
    withAllMixin(all): { disruptionMode+: { all+: all } },
    '#withSingle':: d.fn(help='"SingleCompositeDisruptionMode means that individual children of a CompositePodGroup can be disrupted or preempted independently."', args=[d.arg(name='single', type=d.T.object)]),
    withSingle(single): { disruptionMode+: { single: single } },
    '#withSingleMixin':: d.fn(help='"SingleCompositeDisruptionMode means that individual children of a CompositePodGroup can be disrupted or preempted independently."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='single', type=d.T.object)]),
    withSingleMixin(single): { disruptionMode+: { single+: single } },
  },
  '#schedulingConstraints':: d.obj(help='"CompositePodGroupSchedulingConstraints defines scheduling constraints (e.g. topology) for a CompositePodGroup."'),
  schedulingConstraints: {
    '#withTopology':: d.fn(help='"topology defines the topology constraints for the composite pod group. Currently only a single topology constraint can be specified. This may change in the future."', args=[d.arg(name='topology', type=d.T.array)]),
    withTopology(topology): { schedulingConstraints+: { topology: if std.isArray(v=topology) then topology else [topology] } },
    '#withTopologyMixin':: d.fn(help='"topology defines the topology constraints for the composite pod group. Currently only a single topology constraint can be specified. This may change in the future."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='topology', type=d.T.array)]),
    withTopologyMixin(topology): { schedulingConstraints+: { topology+: if std.isArray(v=topology) then topology else [topology] } },
  },
  '#schedulingPolicy':: d.obj(help='"CompositePodGroupSchedulingPolicy defines the scheduling configuration for a CompositePodGroup. Exactly one policy must be set."'),
  schedulingPolicy: {
    '#gang':: d.obj(help='"CompositeGangSchedulingPolicy indicates that the groups belonging to the composite group should be scheduled using all-or-nothing semantics."'),
    gang: {
      '#withMinGroupCount':: d.fn(help='"minGroupCount is the minimum number of child groups that must be schedulable or scheduled at the same time for the scheduler to admit the entire group. It must be a positive integer."', args=[d.arg(name='minGroupCount', type=d.T.integer)]),
      withMinGroupCount(minGroupCount): { schedulingPolicy+: { gang+: { minGroupCount: minGroupCount } } },
    },
    '#withBasic':: d.fn(help='"CompositeBasicSchedulingPolicy indicates that the groups belonging to the composite group should be scheduled independently."', args=[d.arg(name='basic', type=d.T.object)]),
    withBasic(basic): { schedulingPolicy+: { basic: basic } },
    '#withBasicMixin':: d.fn(help='"CompositeBasicSchedulingPolicy indicates that the groups belonging to the composite group should be scheduled independently."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='basic', type=d.T.object)]),
    withBasicMixin(basic): { schedulingPolicy+: { basic+: basic } },
  },
  '#withCompositePodGroupTemplates':: d.fn(help='"compositePodGroupTemplates is the list of templates for children CompositePodGroups. The maximum number of templates is 8. At least one entry in CompositePodGroupTemplates or PodGroupTemplates must be set."', args=[d.arg(name='compositePodGroupTemplates', type=d.T.array)]),
  withCompositePodGroupTemplates(compositePodGroupTemplates): { compositePodGroupTemplates: if std.isArray(v=compositePodGroupTemplates) then compositePodGroupTemplates else [compositePodGroupTemplates] },
  '#withCompositePodGroupTemplatesMixin':: d.fn(help='"compositePodGroupTemplates is the list of templates for children CompositePodGroups. The maximum number of templates is 8. At least one entry in CompositePodGroupTemplates or PodGroupTemplates must be set."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='compositePodGroupTemplates', type=d.T.array)]),
  withCompositePodGroupTemplatesMixin(compositePodGroupTemplates): { compositePodGroupTemplates+: if std.isArray(v=compositePodGroupTemplates) then compositePodGroupTemplates else [compositePodGroupTemplates] },
  '#withName':: d.fn(help='"name is a unique identifier for the CompositePodGroupTemplate within the Workload. It must be a DNS label. This field is required."', args=[d.arg(name='name', type=d.T.string)]),
  withName(name): { name: name },
  '#withPodGroupTemplates':: d.fn(help='"podGroupTemplates is the list of templates for children PodGroups. The maximum number of templates is 8. At least one entry in CompositePodGroupTemplates or PodGroupTemplates must be set."', args=[d.arg(name='podGroupTemplates', type=d.T.array)]),
  withPodGroupTemplates(podGroupTemplates): { podGroupTemplates: if std.isArray(v=podGroupTemplates) then podGroupTemplates else [podGroupTemplates] },
  '#withPodGroupTemplatesMixin':: d.fn(help='"podGroupTemplates is the list of templates for children PodGroups. The maximum number of templates is 8. At least one entry in CompositePodGroupTemplates or PodGroupTemplates must be set."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='podGroupTemplates', type=d.T.array)]),
  withPodGroupTemplatesMixin(podGroupTemplates): { podGroupTemplates+: if std.isArray(v=podGroupTemplates) then podGroupTemplates else [podGroupTemplates] },
  '#withPreemptionPolicy':: d.fn(help='"preemptionPolicy is the Policy for preempting pods/podgroups with lower priority. One of Never, PreemptLowerPriority. This field is immutable. This field is available only when the PodGroupPreemptionPolicy feature gate is enabled."', args=[d.arg(name='preemptionPolicy', type=d.T.string)]),
  withPreemptionPolicy(preemptionPolicy): { preemptionPolicy: preemptionPolicy },
  '#withPriority':: d.fn(help='"priority is the value of priority of composite pod groups created from this template. Various system components use this field to find the priority of the composite pod group. When Priority Admission Controller is enabled, it prevents users from setting this field. The admission controller populates this field from PriorityClassName. The higher the value, the higher the priority. This field is immutable."', args=[d.arg(name='priority', type=d.T.integer)]),
  withPriority(priority): { priority: priority },
  '#withPriorityClassName':: d.fn(help='"priorityClassName indicates the priority that should be considered when scheduling a composite pod group created from this template. If no priority class is specified, admission control can set this to the global default priority class if it exists. Otherwise, composite pod groups created from this template will have the priority set to zero. This field is immutable."', args=[d.arg(name='priorityClassName', type=d.T.string)]),
  withPriorityClassName(priorityClassName): { priorityClassName: priorityClassName },
  '#mixin': 'ignore',
  mixin: self,
}
