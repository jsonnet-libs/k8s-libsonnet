{
  local d = (import 'doc-util/main.libsonnet'),
  '#':: d.pkg(name='jobSchedulingConfiguration', url='', help='"JobSchedulingConfiguration composes the reusable workload-aware scheduling building blocks."'),
  '#disruptionMode':: d.obj(help='"WorkloadPodGroupDisruptionMode defines how individual pods within a group can be disrupted. Exactly one mode must be set."'),
  disruptionMode: {
    '#withAll':: d.fn(help='"WorkloadPodGroupAllDisruptionMode indicates that all pods in the group must be disrupted together."', args=[d.arg(name='all', type=d.T.object)]),
    withAll(all): { disruptionMode+: { all: all } },
    '#withAllMixin':: d.fn(help='"WorkloadPodGroupAllDisruptionMode indicates that all pods in the group must be disrupted together."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='all', type=d.T.object)]),
    withAllMixin(all): { disruptionMode+: { all+: all } },
    '#withSingle':: d.fn(help='"WorkloadPodGroupSingleDisruptionMode indicates that individual pods can be disrupted independently."', args=[d.arg(name='single', type=d.T.object)]),
    withSingle(single): { disruptionMode+: { single: single } },
    '#withSingleMixin':: d.fn(help='"WorkloadPodGroupSingleDisruptionMode indicates that individual pods can be disrupted independently."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='single', type=d.T.object)]),
    withSingleMixin(single): { disruptionMode+: { single+: single } },
  },
  '#schedulingConstraints':: d.obj(help='"WorkloadPodGroupSchedulingConstraints defines leaf-level scheduling constraints, such as topology."'),
  schedulingConstraints: {
    '#withTopology':: d.fn(help='"topology specifies desired topological placements for all pods within the pod group. If unset, no topology placement is requested."', args=[d.arg(name='topology', type=d.T.array)]),
    withTopology(topology): { schedulingConstraints+: { topology: if std.isArray(v=topology) then topology else [topology] } },
    '#withTopologyMixin':: d.fn(help='"topology specifies desired topological placements for all pods within the pod group. If unset, no topology placement is requested."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='topology', type=d.T.array)]),
    withTopologyMixin(topology): { schedulingConstraints+: { topology+: if std.isArray(v=topology) then topology else [topology] } },
  },
  '#schedulingPolicy':: d.obj(help='"WorkloadPodGroupSchedulingPolicy defines the scheduling policy for a group of pods managed by a workload controller. Exactly one policy must be set."'),
  schedulingPolicy: {
    '#gang':: d.obj(help='"WorkloadPodGroupGangSchedulingPolicy defines the parameters for gang (all-or-nothing) scheduling."'),
    gang: {
      '#withMinCount':: d.fn(help='"minCount is the minimum number of pods that must be scheduled at the same time for the scheduler to admit the entire group. This field is optional. If it is not specified, the controller should inject a context-specific sane default (e.g., parallelism for a Job). If set, it must be a positive integer."', args=[d.arg(name='minCount', type=d.T.integer)]),
      withMinCount(minCount): { schedulingPolicy+: { gang+: { minCount: minCount } } },
    },
    '#withBasic':: d.fn(help='"WorkloadPodGroupBasicSchedulingPolicy indicates standard Kubernetes scheduling behavior."', args=[d.arg(name='basic', type=d.T.object)]),
    withBasic(basic): { schedulingPolicy+: { basic: basic } },
    '#withBasicMixin':: d.fn(help='"WorkloadPodGroupBasicSchedulingPolicy indicates standard Kubernetes scheduling behavior."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='basic', type=d.T.object)]),
    withBasicMixin(basic): { schedulingPolicy+: { basic+: basic } },
  },
  '#withResourceClaims':: d.fn(help="\"ResourceClaims defines which ResourceClaims may be shared among Pods in the Job. Pods consume the devices allocated to a PodGroup's claim by defining a claim in its own Spec.ResourceClaims that matches the PodGroup's claim exactly. The claim must have the same name and refer to the same ResourceClaim or ResourceClaimTemplate. At most 4 claims may be set, matching the limit on the resulting PodGroup. This list is immutable after creation: entries may neither be added, removed, nor modified.\"", args=[d.arg(name='resourceClaims', type=d.T.array)]),
  withResourceClaims(resourceClaims): { resourceClaims: if std.isArray(v=resourceClaims) then resourceClaims else [resourceClaims] },
  '#withResourceClaimsMixin':: d.fn(help="\"ResourceClaims defines which ResourceClaims may be shared among Pods in the Job. Pods consume the devices allocated to a PodGroup's claim by defining a claim in its own Spec.ResourceClaims that matches the PodGroup's claim exactly. The claim must have the same name and refer to the same ResourceClaim or ResourceClaimTemplate. At most 4 claims may be set, matching the limit on the resulting PodGroup. This list is immutable after creation: entries may neither be added, removed, nor modified.\"\n\n**Note:** This function appends passed data to existing values", args=[d.arg(name='resourceClaims', type=d.T.array)]),
  withResourceClaimsMixin(resourceClaims): { resourceClaims+: if std.isArray(v=resourceClaims) then resourceClaims else [resourceClaims] },
  '#mixin': 'ignore',
  mixin: self,
}
